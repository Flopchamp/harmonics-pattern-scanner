# API Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_WS_URL=http://localhost:5000

# TradingView Configuration
REACT_APP_TRADINGVIEW_LIBRARY_PATH=/charting_library/

# Application Configuration
REACT_APP_APP_NAME=Harmonic Pattern Scanner
REACT_APP_VERSION=1.0.0

# Feature Flags
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_TELEGRAM=true
REACT_APP_ENABLE_DARK_MODE=true

# Chart Configuration
REACT_APP_DEFAULT_SYMBOL=BTCUSD
REACT_APP_DEFAULT_INTERVAL=1H
REACT_APP_CHART_THEME=dark

# Development Configuration
REACT_APP_DEBUG_MODE=false
REACT_APP_LOG_LEVEL=error

# External Services
REACT_APP_TELEGRAM_BOT_USERNAME=your_bot_username

# Performance Configuration
REACT_APP_WEBSOCKET_RECONNECT_INTERVAL=5000
REACT_APP_API_TIMEOUT=10000
