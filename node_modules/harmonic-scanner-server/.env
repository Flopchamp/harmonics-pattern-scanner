# Environment Variables Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=harmonic_scanner
DB_USER=root
DB_PASSWORD=4885

# JWT Secret Key (generate a secure random string)
JWT_SECRET=harmonic_scanner_jwt_secret_2025_very_long_and_secure_key_for_authentication

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Session Configuration
SESSION_SECRET=your_session_secret_key

# Logging Configuration
LOG_LEVEL=info

# Pattern Detection Configuration
PATTERN_DETECTION_INTERVAL=60000
MAX_PATTERNS_PER_SYMBOL=50

# Market Data Configuration (Set to simulation mode for demo)
USE_SIMULATION_DATA=true
DATA_PROVIDER=simulation
# MARKET_DATA_API_KEY=your_api_key_here

# Alpha Vantage API (Free tier: 25 requests/day)
# Get free API key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# Polygon.io API (Paid service with real-time data)
# Get API key at: https://polygon.io/
POLYGON_API_KEY=your_polygon_api_key

# Alternative FX Data Providers
# FXAPI_KEY=your_fxapi_key
# OANDA_API_KEY=your_oanda_api_key
