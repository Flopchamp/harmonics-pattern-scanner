{
  "name": "harmonic-scanner",
  "version": "1.0.0",
  "description": "Real-time harmonic pattern scanner with TradingView integration",
  "main": "server/src/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "test": "jest",
    "install-all": "npm install && cd client && npm install && cd ../server && npm install"
  },
  "keywords": [
    "harmonic",
    "patterns",
    "trading",
    "forex",
    "scanner"
  ],
  "author": "Harmonic Scanner Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.5.0"
  },
  "workspaces": [
    "client",
    "server"
  ]
}
